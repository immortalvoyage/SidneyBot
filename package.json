{
  "name": "sidney-discord-ai-bot",
  "version": "4.3.22",
  "private": true,
  "type": "module",
  "description": "ImmortalVoyage Platform - 仙遊者 Discord 模組（Cloudflare Workers + Gemini + KV）",
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "register": "node register-commands.js",
    "release:check": "node scripts/release-preflight.js && npm run check && npm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "setup:discord": "powershell -ExecutionPolicy Bypass -File scripts/setup-discord-local.ps1",
    "gateway": "node --env-file=.dev.vars gateway.js"
  },
  "devDependencies": {
    "wrangler": "^4.28.0"
  }
}
